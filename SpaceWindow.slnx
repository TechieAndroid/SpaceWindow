<Solution>
  <Configurations>
    <BuildType Name="Debug" />
    <BuildType Name="Release" />
    <BuildType Name="Asan" />
    <Platform Name="x64" />
    <Platform Name="ARM64" />
  </Configurations>
  <Folder Name="/build/">
    <File Path="build/SpaceWindow.Cpp.props" />
    <File Path="build.ps1" />
    <File Path=".clang-tidy" />
    <File Path="README.md" />
  </Folder>
  <Folder Name="/src/">
    <Project Path="src/Core/Core.vcxproj">
      <Build Solution="Asan|ARM64" Project="false" />
    </Project>
    <Project Path="src/App/SpaceWindow.vcxproj">
      <BuildType Solution="Asan|*" Project="Debug" />
      <Build Solution="Asan|*" Project="false" />
    </Project>
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/CoreTests/CoreTests.vcxproj">
      <Build Solution="Asan|ARM64" Project="false" />
    </Project>
  </Folder>
</Solution>
