<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="SpaceWindow.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Section headings in the dialogs. -->
            <Style x:Key="SectionHeaderStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,12,0,4" />
            </Style>

            <!-- A key of a keyboard shortcut in Settings, drawn as a key cap. -->
            <Style x:Key="KeyCapStyle" TargetType="Border">
                <Setter Property="MinWidth" Value="26" />
                <Setter Property="Padding" Value="6,2,6,3" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlElevationBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
